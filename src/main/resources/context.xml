<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:context="http://www.springframework.org/schema/context"

       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd
        http://www.springframework.org/schema/context http://www.springframework.org/schema/context/spring-context.xsd">

    <!--
        Replaces <constretto:configuration>, which registered three things: the
        injectable ApplicationConfiguration bean, a property placeholder configurer
        for the ${...} below, and the @Configure/@Configuration post-processor. The
        first two are the two beans here; the third is gone because the three
        constructors that used it now take @Value.

        The SAME instance is injected into UserAdminHelper and
        RDBMSUserIdentityRepository and feeds the placeholder configurer, as the
        single ApplicationConfiguration did. The resource list is unchanged, and
        ApplicationConfiguration reproduces Constretto's resolution order,
        including the @CI. / @DEV. / @IDE. tagged keys.
    -->
    <bean id="configuration" class="net.whydah.identity.config.ApplicationConfiguration">
        <constructor-arg>
            <array>
                <value>classpath:useridentitybackend.properties</value>
                <value>file:./useridentitybackend_override.properties</value>
            </array>
        </constructor-arg>
    </bean>

    <bean class="org.springframework.context.support.PropertySourcesPlaceholderConfigurer">
        <property name="properties">
            <bean factory-bean="configuration" factory-method="asProperties"/>
        </property>
    </bean>

    <context:component-scan base-package="net.whydah.identity">
        <!--<context:include-filter type="annotation" expression="org.springframework.stereotype.Component"/>-->
    </context:component-scan>

    <bean id="dataSource" class="org.apache.commons.dbcp.BasicDataSource" destroy-method="close">
        <property name="driverClassName" value="${roledb.jdbc.driver}"/>
        <property name="url" value="${roledb.jdbc.url}"/>
        <property name="username" value="${roledb.jdbc.user}"/>
        <property name="password" value="${roledb.jdbc.password}"/>
    </bean>


    <bean id="luceneUserDirectory" class="org.apache.lucene.store.NIOFSDirectory">
        <constructor-arg ref="luceneUserDirectoryPath"/>
    </bean>

    <bean id="luceneApplicationDirectory" class="org.apache.lucene.store.NIOFSDirectory">
        <constructor-arg ref="luceneApplicationDirectoryPath"/>
    </bean>

    <bean id="luceneUserDirectoryPath" class="java.nio.file.Paths" factory-method="get">
        <constructor-arg value="${lucene.usersdirectory}" />
        <constructor-arg><array /></constructor-arg>
    </bean>

    <bean id="luceneApplicationDirectoryPath" class="java.nio.file.Paths" factory-method="get">
        <constructor-arg value="${lucene.applicationsdirectory}" />
        <constructor-arg><array /></constructor-arg>
    </bean>

    <bean id="objectMapper" class="com.fasterxml.jackson.databind.ObjectMapper"/>
    <!-- <bean id="objectMapper" class="com.company.CustomObjectMapper"/>-->
</beans>